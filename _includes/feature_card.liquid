<div class="col-lg-4 col-md-6 mb-4">
  <a class="feature-card" href="{{ include.url | relative_url }}">
    <div class="feature-card-image">
      {% include figure.liquid loading="eager" path=include.image class="img-fluid" alt=include.alt %}
    </div>
    <div class="feature-card-body">
      <h4>{{ include.title }}</h4>
      <p>{{ include.text }}</p>
    </div>
  </a>
</div>
